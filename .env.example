# Telegram Bot Token (от @BotFather)
# Локально: BOT_TOKEN. На Vercel: BOT_TOKEN или TELEGRAM_BOT_TOKEN
BOT_TOKEN=

# OpenAI API Key (для сравнения смысла и выбора источников)
OPENAI_API_KEY=

# Опционально: Google Custom Search (поиск источников)
# GOOGLE_CSE_ID=
# GOOGLE_API_KEY=

# Базовый URL приложения (для setWebhook, после деплоя на Vercel)
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Временно: пропуск валидации initData Mini App (если появляется ошибка "Недействительные данные Mini App")
# SKIP_INITDATA_VALIDATION=true
